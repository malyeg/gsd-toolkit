#!/usr/bin/env bash
#
# gsdt-migrate — move a repo to the gsdt-* command names (gsd-toolkit 0.10.0).
#
# Before 0.10.0 the toolkit's commands were gsd-*, the same start as every
# gsd-core skill. They are gsdt-* now, with no old-name aliases, so a repo set
# up before keeps files and settings that name the old commands. This moves
# them. Run it in the repo (any checkout; it works on the main one).
#
# Usage:
#   gsdt-migrate             dry run: list every change, change nothing
#                            (exit 1 when there is anything to do)
#   gsdt-migrate --apply     make the changes (never commits, pushes or
#                            checks out)
#   gsdt-migrate --check     quiet; exit 1 when the repo or this clone still
#                            uses an old name (not step 7: install replaces
#                            those hooks, and doctor's T008 sees a stale one)
#   --repo DIR               the repo (default: the current directory)
#   -h, --help               show this help
#
# What it changes (each only when it is there):
#   1. the five shims: scripts/gsd-*.sh → scripts/gsdt-*.sh (a shim you
#      edited is reported and left alone)
#   2. your pre-merge script: scripts/gsd-premerge-check.sh → gsdt-…
#   3. those paths where other tracked files name them (package.json, CI,
#      Makefile, .husky/…): exact paths only; never .planning/ or *.md
#   4. the repo hook in .claude/settings.json
#   5. the toolkit's marked blocks in .gsd/INSTRUCTIONS.md, CLAUDE.md,
#      AGENTS.md (text outside the markers is never touched)
#   6. this clone's git config: the merge driver's command, the
#      gsd-tracker section (→ gsdt-tracker), the post-merge hook
#   7. your Claude user settings: the toolkit's --global guard and
#      gsdt-rules hooks (only when an old one is there)
# What it only reports: open phase worktrees, old names in free text
# (.planning/, docs), files you edited by hand.
#
# Steps 6–7 are per clone: each teammate runs gsdt-migrate --apply in their
# own clone after the commit with steps 1–5 reaches them.
set -uo pipefail

usage() { awk 'NR>1 && /^set -uo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }
die() { printf '✖ %s\n' "$*" >&2; exit 2; }

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"

MODE=dry; REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    --apply) MODE=apply; shift ;;
    --check) MODE=check; shift ;;
    --repo) [ $# -ge 2 ] || die "--repo needs a directory"; REPO=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1 (see gsdt-migrate --help)" ;;
  esac
done

# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh"
# shellcheck source=../lib/provider.sh
. "$GSD_PKG/lib/provider.sh"

git -C "${REPO:-.}" rev-parse --show-toplevel >/dev/null 2>&1 || die "not a git repo: ${REPO:-$PWD}"
MAIN=$(gsd_main "${REPO:-.}")
[ -n "$MAIN" ] || die "could not find the main checkout of ${REPO:-$PWD}"
PY=$(gsd_python) || die "gsdt-migrate needs python 3.7+ (python3)"

[ "$MODE" != apply ] || gsd_acquire_lock "$MAIN" || exit 1

CHANGES=0; PROBLEMS=0; NOTES=""
# say: one line of the report (nothing with --check)
say() { [ "$MODE" = check ] || printf '%s\n' "$*"; }
change() { CHANGES=$((CHANGES + 1)); say "  $*"; }
problem() { PROBLEMS=$((PROBLEMS + 1)); say "  ✖ $*"; }
note() { NOTES="${NOTES}  • $*"$'\n'; }
doing() { [ "$MODE" = apply ]; }

# The old command names, for the text checks below. A name counts when it
# stands alone, or as a scripts/ path; a slash command (/gsd-update is also a
# gsd-core skill) does not.
OLD_NAMES='init|start|list|finish|doctor|update|bootstrap-repo|planning-repair|tracker|ui|codex-wait|batch|batch-report|wt-new|wt-finish|worktree-guard|flow-next|planning-merge|derive-port|rules|new-worktree-feature|finish-worktree-feature|premerge-check'
export GSD_OLD_RE="(?:(?<![\\w./-])|(?<=scripts/)|(?<=hooks/))gsd-(?:${OLD_NAMES})(?![\\w-])"
has_old() { perl -ne 'BEGIN{$re=qr/$ENV{GSD_OLD_RE}/} $f=1 if /$re/; END{exit($f?0:1)}'; }

new_name() { printf '%s' "$1" | sed -E 's#(^|/)gsd-#\1gsdt-#'; }

[ "$MODE" = check ] || printf 'gsdt-migrate%s — %s\n' "$([ "$MODE" = apply ] || echo ' (dry run)')" "$MAIN"

# ── 1. shims ─────────────────────────────────────────────────────────────────
say "shims:"
for old in $GSD_OLD_SHIMS; do
  [ -f "$MAIN/$old" ] || continue
  new=$(new_name "$old")
  if ! sed -n 2p "$MAIN/$old" | grep -qE '^# gsd-(worktrees|toolkit) shim'; then
    problem "$old: not the toolkit's shim (edited by hand?) — left alone; rename it to $new and point it at gsdt-* yourself"
    continue
  fi
  change "$old → $new"
  if doing; then
    mkdir -p "$(dirname "$MAIN/$new")"
    cp "$GSD_PKG/shims/$new" "$MAIN/$new" && chmod +x "$MAIN/$new" && rm -f "$MAIN/$old"
  fi
done

# ── 2. the pre-merge script (yours) ──────────────────────────────────────────
pm_new=$(new_name "$GSD_OLD_PREMERGE")
if [ -f "$MAIN/$GSD_OLD_PREMERGE" ]; then
  if [ -e "$MAIN/$pm_new" ]; then
    problem "both $GSD_OLD_PREMERGE and $pm_new exist — keep one (gsdt-finish runs $pm_new)"
  else
    change "$GSD_OLD_PREMERGE → $pm_new (your pre-merge script, renamed as it is)"
    doing && mv "$MAIN/$GSD_OLD_PREMERGE" "$MAIN/$pm_new"
  fi
fi

# ── 3. references to those paths in other tracked files ─────────────────────
# Exact paths only. Never .planning/ or prose (*.md, *.txt): those are reported.
PATH_RE='(?<![\w-])scripts/(?:gsd-(?:new-worktree-feature|finish-worktree-feature|derive-port|planning-repair|premerge-check)\.sh|hooks/gsd-worktree-guard\.sh)'
export PATH_RE
say "references:"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # the pre-merge script was moved above (--apply): read it at its new name
  [ -f "$MAIN/$f" ] || { [ "$f" = "$GSD_OLD_PREMERGE" ] && f=$pm_new; }
  [ -f "$MAIN/$f" ] || continue
  case "$f" in .planning/*|*.md|*.markdown|*.txt|.claude/settings.json) continue ;; esac
  for o in $GSD_OLD_SHIMS; do [ "$f" != "$o" ] || continue 2; done
  hits=$(perl -ne 'BEGIN{$re=qr/$ENV{PATH_RE}/} if (/$re/) { chomp; print "$.: $_\n" }' "$MAIN/$f")
  [ -n "$hits" ] || continue
  while IFS= read -r h; do change "$f:${h}"; done <<< "$hits"
  doing && perl -pi -e 'BEGIN{$re=qr/$ENV{PATH_RE}/} s{$re}{ my $m=$&; $m =~ s#(^|/)gsd-#${1}gsdt-#; $m }ge' "$MAIN/$f"
done < <(git -C "$MAIN" grep -lIE 'scripts/(hooks/)?gsd-[a-z-]+\.sh' 2>/dev/null)

# ── 4 + 7. hooks in settings files (JSON) ────────────────────────────────────
# repo: our shim path in the repo's Claude settings. user: our --global guard
# and gsdt-rules --hook in the user's Claude settings. Renamed in place; a hook
# that then duplicates one already there is dropped. Exit 3 = would change.
settings_fix() {  # $1=repo|user $2=file $3=check|apply
  "$PY" - "$@" <<'PY'
import json, os, re, sys
kind, path, mode = sys.argv[1:]
try:
    text = open(path).read()
    data = json.loads(text)
except (OSError, ValueError):
    sys.exit(0)
if not isinstance(data, dict) or not isinstance(data.get("hooks"), dict):
    sys.exit(0)
if kind == "repo":
    rx = re.compile(r"scripts/hooks/gsd-worktree-guard\.sh")
    sub = lambda c: rx.sub("scripts/hooks/gsdt-worktree-guard.sh", c)
else:
    rx = re.compile(r"(?<![\w-])gsd-(worktree-guard|rules)(?![\w-])")
    ours = lambda c: ("worktree-guard" in c and "--global" in c) or ("rules" in c and "--hook" in c)
    sub = lambda c: rx.sub(r"gsdt-\1", c) if ours(c) else c
changed = False
for event, groups in data["hooks"].items():
    if not isinstance(groups, list):
        continue
    seen = set()
    for g in groups:
        if not isinstance(g, dict) or not isinstance(g.get("hooks"), list):
            continue
        kept = []
        for h in g["hooks"]:
            if isinstance(h, dict) and isinstance(h.get("command"), str):
                c = sub(h["command"])
                if c != h["command"]:
                    h["command"] = c; changed = True
                key = (g.get("matcher"), c)
                if key in seen and "gsdt-" in c:  # now a twin of ours: drop it
                    changed = True
                    continue
                seen.add(key)
            kept.append(h)
        g["hooks"] = kept
    data["hooks"][event] = [g for g in groups if not (isinstance(g, dict) and g.get("hooks") == [])]
if not changed:
    sys.exit(0)
if mode == "check":
    sys.exit(3)
real = os.path.realpath(path)
tmp = real + ".gsd-tmp"
with open(tmp, "w") as f:
    f.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
try:
    os.chmod(tmp, os.stat(real).st_mode & 0o7777)
except OSError:
    pass
os.replace(tmp, real)
sys.exit(3)
PY
}
settings_step() {  # $1=repo|user $2=file $3=label
  [ -f "$2" ] || return 0
  settings_fix "$1" "$2" check; [ $? = 3 ] || return 0
  change "$3"
  doing && settings_fix "$1" "$2" apply
  return 0
}
say "repo hook:"
settings_step repo "$MAIN/.claude/settings.json" ".claude/settings.json: hook scripts/hooks/gsd-worktree-guard.sh → gsdt-worktree-guard.sh"

# ── 5. the toolkit's marked blocks ───────────────────────────────────────────
say "instruction blocks:"
PROVIDERS=$(gsd_conf_providers "$MAIN" | tr -d '[:space:]' | sed -e 's/,gemini,/,/g; s/^gemini,//; s/,gemini$//; s/^gemini$//')
PROVIDERS=${PROVIDERS:-claude}
block_step() {  # $1=file (relative) $2=kind $3=members (provider blocks)
  local f="$MAIN/$1" tmp
  gsd_owned_block_get "$f" "$2" | has_old || return 0
  if ! gsd_owned_markers_valid "$f" "$2"; then
    problem "$1: its gsd-toolkit:$2 markers are broken — repair the start/end pair, then run gsdt-migrate again"; return 0
  fi
  change "$1: the gsd-toolkit:$2 block, rewritten with the gsdt-* names"
  doing || return 0
  tmp=$(mktemp)
  if [ "$2" = canonical ]; then
    gsd_canonical_block "$PROVIDERS" "${PROVIDERS%%,*}" "$(gsd_base "$MAIN")" "$(gsd_wtdir "$MAIN")" > "$tmp"
  else
    gsd_provider_entry_block "$3" > "$tmp"
  fi
  gsd_replace_owned_block "$f" "$2" "$tmp"; rm -f "$tmp"
}
block_step .gsd/INSTRUCTIONS.md canonical ""
seen_files=","
for f in CLAUDE.md AGENTS.md; do
  members=$(gsd_provider_instruction_members "$MAIN/$f" | head -1)
  if [ -z "$members" ]; then  # an older header: the providers that use this file
    oldifs=$IFS; IFS=,; for p in $PROVIDERS; do
      [ "$(gsd_provider_instruction_file "$p")" != "$f" ] || members="${members:+$members,}$p"
    done; IFS=$oldifs
  fi
  case "$seen_files" in *",$f,"*) continue ;; esac; seen_files="$seen_files$f,"
  block_step "$f" provider "${members:-claude}"
done

# ── 6. this clone's git config + post-merge hook ─────────────────────────────
say "this clone (.git/config):"
if [ "$(git -C "$MAIN" config --get merge.gsd-planning.driver 2>/dev/null)" = "gsd-planning-merge %O %A %B %P" ]; then
  change "merge.gsd-planning.driver: gsd-planning-merge → gsdt-planning-merge (the driver key stays gsd-planning)"
  doing && git -C "$MAIN" config merge.gsd-planning.driver "gsdt-planning-merge %O %A %B %P"
fi
old_keys=$(git -C "$MAIN" config --local --get-regexp '^gsd-tracker\.' 2>/dev/null || true)
if [ -n "$old_keys" ]; then
  change "git config section gsd-tracker → gsdt-tracker ($(printf '%s\n' "$old_keys" | wc -l | tr -d ' ') key(s))"
  if doing; then
    while IFS= read -r kv; do
      k=${kv%% *}; v=${kv#* }; [ "$kv" != "$k" ] || v=""
      nk="gsdt-tracker.${k#gsd-tracker.}"
      git -C "$MAIN" config --local --get "$nk" >/dev/null 2>&1 || git -C "$MAIN" config --local "$nk" "$v"
    done <<< "$old_keys"
    git -C "$MAIN" config --local --remove-section gsd-tracker 2>/dev/null || true
  fi
fi
gsd_planning_hook "$MAIN"
if [ -f "$GSD_HOOK_PATH" ] && grep -q 'gsd-planning-repair' "$GSD_HOOK_PATH"; then
  change "${GSD_HOOK_LABEL}: gsd-planning-repair → gsdt-planning-repair"
  doing && perl -pi -e 's/(?<![\w-])gsd-(planning-repair|bootstrap-repo)(?![\w-])/gsdt-$1/g' "$GSD_HOOK_PATH"
fi

# ── 7. the user's Claude settings ────────────────────────────────────────────
say "your Claude settings:"
USER_SETTINGS=$(gsd_provider_user_hook_file claude 2>/dev/null || true)
[ "$MODE" = check ] || [ -z "$USER_SETTINGS" ] || settings_step user "$USER_SETTINGS" "${USER_SETTINGS}: the toolkit's hooks gsd-worktree-guard / gsd-rules → gsdt-*"

# ── only reported ────────────────────────────────────────────────────────────
while IFS= read -r line; do
  case "$line" in
    "worktree "*) wt=${line#worktree } ;;
    "branch refs/heads/"*)
      br=${line#branch refs/heads/}
      [ "$wt" != "$MAIN" ] || continue
      case "$br" in phase-*|batch-*) ;; *) continue ;; esac
      for o in $GSD_OLD_SHIMS; do
        if [ -f "$wt/$o" ]; then
          note "open worktree $br still has the old files: commit this migration on the base branch, then merge it into $br (or finish $br first)"
          break
        fi
      done ;;
  esac
done < <(git -C "$MAIN" worktree list --porcelain 2>/dev/null)

free=$(cd "$MAIN" && git ls-files -- .planning '*.md' '*.markdown' '*.txt' 2>/dev/null | while IFS= read -r f; do
  [ -f "$f" ] || continue
  perl -ne 'BEGIN{$re=qr/$ENV{GSD_OLD_RE}/}
    $in=1 if /^<!-- gsd-(?:toolkit|worktrees):\w+:start -->$/;
    print "$ARGV:$.\n" if !$in && /$re/;
    $in=0 if /^<!-- gsd-(?:toolkit|worktrees):\w+:end -->$/;' "$f"
done)
if [ -n "$free" ]; then
  n=$(printf '%s\n' "$free" | wc -l | tr -d ' ')
  note "$n line(s) of free text still name old gsd-* commands (not changed; fix them if you like): $(printf '%s\n' "$free" | head -8 | tr '\n' ' ')$([ "$n" -le 8 ] || echo "…")"
fi

# ── result ───────────────────────────────────────────────────────────────────
[ "$MODE" != check ] || { [ "$CHANGES" -eq 0 ] && [ "$PROBLEMS" -eq 0 ]; exit $?; }
if [ -n "$NOTES" ]; then echo ""; echo "notes:"; printf '%s' "$NOTES"; fi
echo ""
if [ "$MODE" = dry ]; then
  if [ "$CHANGES" -eq 0 ] && [ "$PROBLEMS" -eq 0 ]; then echo "✔ nothing to migrate: this repo uses the gsdt-* names"; exit 0; fi
  [ "$CHANGES" -eq 0 ] || echo "${CHANGES} change(s). Nothing changed yet — run: gsdt-migrate --apply"
  [ "$PROBLEMS" -eq 0 ] || echo "${PROBLEMS} item(s) need a hand fix (✖ above)."
  exit 1
fi
if [ "$CHANGES" -eq 0 ] && [ "$PROBLEMS" -eq 0 ]; then echo "✔ nothing to migrate: this repo uses the gsdt-* names"; exit 0; fi
[ "$CHANGES" -eq 0 ] || {
  echo "✔ migrated to gsdt-* (${CHANGES} change(s), not committed)"
  echo "next:  git -C '$MAIN' add -A && git -C '$MAIN' commit -m 'Switch to gsdt-* toolkit commands'"
  echo "       then each teammate: gsdt-update, then gsdt-migrate --apply in their clone"
}
[ "$PROBLEMS" -eq 0 ] || { echo "${PROBLEMS} item(s) still need a hand fix (✖ above); then run gsdt-migrate again."; exit 1; }
exit 0

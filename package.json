{
  "name": "gsd-toolkit",
  "version": "0.13.2",
  "description": "Worktree-per-phase, provider-neutral commands around GSD (gsd-core).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gsdt-batch": "dist/bin/gsdt-batch.js",
    "gsdt-batch-report": "dist/bin/gsdt-batch-report.js",
    "gsdt-bootstrap-repo": "dist/bin/gsdt-bootstrap-repo.js",
    "gsdt-codex-wait": "dist/bin/gsdt-codex-wait.js",
    "gsdt-derive-port": "dist/bin/gsdt-derive-port.js",
    "gsdt-doctor": "dist/bin/gsdt-doctor.js",
    "gsdt-finish": "dist/bin/gsdt-finish.js",
    "gsdt-flow-next": "dist/bin/gsdt-flow-next.js",
    "gsdt-init": "dist/bin/gsdt-init.js",
    "gsdt-list": "dist/bin/gsdt-list.js",
    "gsdt-migrate": "dist/bin/gsdt-migrate.js",
    "gsdt-notify": "dist/bin/gsdt-notify.js",
    "gsdt-planning-merge": "dist/bin/gsdt-planning-merge.js",
    "gsdt-planning-repair": "dist/bin/gsdt-planning-repair.js",
    "gsdt-repos": "dist/bin/gsdt-repos.js",
    "gsdt-rules": "dist/bin/gsdt-rules.js",
    "gsdt-setup": "dist/bin/gsdt-setup.js",
    "gsdt-start": "dist/bin/gsdt-start.js",
    "gsdt-tracker": "dist/bin/gsdt-tracker.js",
    "gsdt-ui": "dist/bin/gsdt-ui.js",
    "gsdt-update": "dist/bin/gsdt-update.js",
    "gsdt-worktree-guard": "dist/bin/gsdt-worktree-guard.js",
    "gsdt-wt-finish": "dist/bin/gsdt-wt-finish.js",
    "gsdt-wt-new": "dist/bin/gsdt-wt-new.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/launch.mjs",
    "lib/vendor/",
    "shims/",
    "skills/",
    "VERSION",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "prepack": "node tools/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}

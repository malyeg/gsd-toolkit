#!/usr/bin/env bash
#
# gsdt-wt-finish — merge a finished phase worktree back into the base branch,
# push, and clean up the worktree + branch. The worker behind gsdt-finish;
# callable standalone too.
#
# Usage (from inside the target repo):
#   gsdt-wt-finish <N | phase-N-slug | batch-…> [base]
#   gsdt-wt-finish 1                       # finds phase-1-* (never *-pr)
#   gsdt-wt-finish phase-1-customer-onboarding-terms
#   gsdt-wt-finish batch-2026-11-09-fix-labels   # a gsdt-batch worktree
#
# Merge order (src/commands/wt-finish.ts): lock → sync origin → gates →
# validate → merge → .planning repair → validate → push (3 retries) → cleanup.
set -euo pipefail

# Ported to TypeScript (src/commands/wt-finish.ts); this launcher only finds
# the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-wt-finish: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" wt-finish "$@"

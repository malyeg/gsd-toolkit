#!/usr/bin/env bash
#
# gsdt-wt-new — create the worktree for a GSD phase in ONE step (branch +
# worktree dir = phase-<N>-<slug>; reuses an existing one).
#
# Usage (from inside the target repo, typically its main checkout):
#   gsdt-wt-new [slug] [--phase <N>] [--no-install|--install]
#   gsdt-wt-new --batch batch-<date>-<slug> [--no-install|--install]
#
# What the options mean: gsdt-wt-new --help. Repo settings (base branch,
# worktree dir, install command): .gsd.conf, see gsdt-bootstrap-repo.
set -euo pipefail

# Ported to TypeScript (src/commands/wt-new.ts, which holds the --help text);
# this launcher only finds the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-wt-new: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" wt-new "$@"

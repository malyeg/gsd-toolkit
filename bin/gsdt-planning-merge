#!/usr/bin/env bash
#
# gsdt-planning-merge — git merge driver for the union-merged GSD planning files
# (.planning/ROADMAP.md, .planning/STATE.md). Union-then-reconcile: take the
# both-sides result git's built-in `union` driver would have produced, then
# collapse every line that is a single source of truth back to one value, so
# the contradiction never lands on the branch in the first place.
#
# Registered per clone (merge drivers live in git config, which is not
# versioned) by gsdt-bootstrap-repo, and re-asserted by gsdt-wt-finish on every
# run — see gsd_register_merge_driver in lib/common.sh. Paired with
# `.planning/... merge=gsd-planning` in the repo's .gitattributes.
#
# Usage (git calls it; you should not):
#   gsdt-planning-merge %O %A %B %P
#     %O  common-ancestor version
#     %A  OUR version — the driver must leave the merged result here
#     %B  THEIR (incoming) version
#     %P  the file's path in the repo
#
# Always exits 0: union never conflicts, and a reconciliation that finds nothing
# to do is a no-op. Counters are NOT recomputed here — a merge driver runs
# mid-merge, when the rest of the tree is not yet consistent — so conflicting
# counters resolve to the most-advanced candidate and `gsdt-planning-repair`
# (run by gsdt-finish and the post-merge hook) recomputes them from ground truth.
#
# Degrades safely: with no usable node (>= 24) it does the plain union in bash
# and warns, which is exactly the old no-python behaviour, never worse.
#
# Launcher: the union and the no-node fallback stay in bash on purpose (a
# merge driver must never exit nonzero — git would take it for a conflict —
# and the union must land even if node dies); the reconcile is the engine
# src/planning.ts (it replaced lib/gsd_planning.py), run by Node >= 24 as
# `src/launch.mjs planning reconcile`. See docs/ts-port-progress.md.
set -euo pipefail

O="${1:?merge driver needs %O}"
A="${2:?merge driver needs %A}"
B="${3:?merge driver needs %B}"
P="${4:-}"

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"

# Union first, in bash: same result git's built-in union driver produces,
# written to %A. Whatever happens to node after this, the union is in place.
git merge-file -q --union "$A" "$O" "$B" || true

if ! command -v node >/dev/null 2>&1 \
   || ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)' 2>/dev/null; then
  echo "⚠ gsdt-planning-merge: no usable node (needs Node.js >= 24) — left the plain union result in ${P:-$A}." >&2
  echo "  It may contain both sides of single-value lines; run gsdt-planning-repair after the merge." >&2
  exit 0
fi

node "$GSD_PKG/src/launch.mjs" planning reconcile "$A" ${P:+--path "$P"} \
  || echo "⚠ gsdt-planning-merge: reconcile failed on ${P:-$A} — plain union result kept; run gsdt-planning-repair." >&2

exit 0

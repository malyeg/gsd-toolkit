#!/usr/bin/env bash
#
# gsdt-batch — run several quick tasks as one batch, in a FRESH session with
# the gsdt-batch skill already running, in a worktree of its own (batch-<date>-<slug>).
#
# Usage (from anywhere inside the repo):
#   gsdt-batch [options] [--] <task list | brief | --file <path>> [gsd-quick-batch flags]
#
# What the options mean, with examples: gsdt-batch --help.
set -uo pipefail

# Ported to TypeScript (src/commands/batch.ts, which holds the --help text);
# this launcher only finds the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-batch: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" batch "$@"

#!/usr/bin/env bash
#
# gsdt-bootstrap-repo — install the GSD worktree integration into the current
# repo (config, shims, instructions, hooks). gsdt-init wraps it.
# Options: gsdt-bootstrap-repo --help.
set -euo pipefail

# Ported to TypeScript (src/commands/bootstrap-repo.ts, which holds the --help text);
# this launcher only finds the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-bootstrap-repo: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" bootstrap-repo "$@"

#!/usr/bin/env bash
#
# gsdt-start — start a GSD feature in ONE step: claim the phase, sync the claim,
# create the worktree, and open the session there (--no-launch prints it instead).
#
# Usage (from anywhere inside a GSD-fitted repo or its worktrees):
#   gsdt-start -n "<phase description>" [--slug <slug>] [--repo <path>] [--no-push]
#   gsdt-start --insert <N> "<phase description>" [--slug <slug>] [--repo <path>]
#   gsdt-start -p <N> [--slug <slug>] [--repo <path>]
#   (all take: --provider, --model, --agent-command, --flow/--no-flow,
#    --launch/--no-launch, --ticket <id>/--no-ticket)
#
# What the options mean, with examples: gsdt-start --help.
set -euo pipefail

# Ported to TypeScript (src/commands/start.ts, which holds the --help text);
# this launcher only finds the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-start: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" start "$@"

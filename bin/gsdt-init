#!/usr/bin/env bash
#
# gsdt-init — take a repo with NO GSD to "ready for gsdt-start" in one command:
# installs the worktree workflow (gsdt-bootstrap-repo), then opens the agent
# session that makes the plan. Options: gsdt-init --help.
set -euo pipefail

# Ported to TypeScript (src/commands/init.ts, which holds the --help text);
# this launcher only finds the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-init: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" init "$@"

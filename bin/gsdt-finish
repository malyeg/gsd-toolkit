#!/usr/bin/env bash
#
# gsdt-finish — finish a GSD phase from anywhere: merge the phase worktree back
# into the base branch, push, and remove the worktree + branch.
#
# Usage:
#   gsdt-finish                      # from inside a phase-N-* or batch-* worktree
#   gsdt-finish <N | phase-N-slug>   # from anywhere in the repo
#   gsdt-finish batch-<date>-<slug>  # a gsdt-batch worktree
#   gsdt-finish <N> --repo <path>    # from outside the repo
#   gsdt-finish <N> --pr [--draft]   # push + open a PR instead of merging
#
# What the options do, and the safety rules: gsdt-finish --help.
set -euo pipefail

# Ported to TypeScript (src/commands/finish.ts, which holds the --help text);
# this launcher only finds the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-finish: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" finish "$@"

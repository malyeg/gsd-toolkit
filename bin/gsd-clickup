#!/usr/bin/env bash
#
# gsd-clickup — gsd-tracker with the tracker fixed to ClickUp.
#
#   gsd-clickup <command> …   ==   gsd-tracker --tracker clickup <command> …
#
# Where the tracker is set to clickup, or nothing is set and there is no
# .gsd.conf, plain gsd-tracker does the same.
# Shared verbs (start, finish, comment, status, snapshot, check): see
# gsd-tracker --help. ClickUp's options for create/update/tasks, and its own
# commands (lists, members, api, login):
#   create  <list-id> <name> [--desc <md>|-] [--assign <who>]… [--status <s>]
#           [--priority 1-4] [--tag <t>]… [--parent <id>]   prints the new id + url
#   update  <id> [--name <n>] [--desc <md>|-] [--assign <who>]… [--unassign <who>]…
#           [--status <s>] [--priority 1-4] [--parent <id>]
#   tasks   [--list <id>]… [--status <s>]… [--assign <who>]… [--tag <t>]…
#           [--closed] [--match <text>] [--page <n>]        "<id>  [<status>]  <name> · <list>"
#   lists                    spaces, folders and lists, with ids
#   members                  workspace members: id, username, email
#   api     <GET|POST|PUT|DELETE> </path> [json]   any API v2 call; prints the body
#   login   [<profile>]      a token for this repo, in any folder: offers the one
#                            already saved for <profile> (use or replace), else asks
#                            (hidden); tests it, saves ~/.config/gsd/clickup-<profile>.env
#                            and, in a git repo, sets git config gsd-tracker.profile
#                            (default profile: the one in use, else the repo folder's name)
#
# <who> is me, a user id, an email or a username. --desc - reads stdin.
# Priority: 1 urgent · 2 high · 3 normal · 4 low. --match filters task names
# (the API has no text search) over up to 10 pages of 100.
# The workspace: $CLICKUP_TEAM_ID (env or the token file), else the only one
# the token sees. Login and profiles: see gsd-tracker --help.
set -euo pipefail
SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
case "${1:-}" in
  -h|--help) awk 'NR>1 && /^set -euo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; exit 0 ;;
esac
exec "$(dirname "$SELF")/gsd-tracker" --tracker clickup "$@"

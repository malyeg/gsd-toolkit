#!/usr/bin/env bash
#
# gsdt-migrate — move a repo to the gsdt-* command names (gsd-toolkit 0.10.0).
#
# Usage: gsdt-migrate [--apply | --check] [--repo DIR]   (gsdt-migrate --help)
set -uo pipefail

# Ported to TypeScript (src/commands/migrate.ts, which holds the --help text);
# this launcher only finds the package.
SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-migrate: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" migrate "$@"

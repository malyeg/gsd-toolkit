#!/usr/bin/env bash
#
# gsdt-derive-port <base> — print <base> plus this worktree's phase number, so
# a per-app `dev` script can pick a per-worktree port (phase-8 -> base+8; any
# other branch, or outside git -> the bare base).
#
# Launcher: the command is src/commands/derive-port.ts (TypeScript, run by
# Node >= 24 through src/launch.mjs). See docs/ts-port-progress.md.
SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
command -v node >/dev/null 2>&1 || { echo "gsdt-derive-port: needs Node.js >= 24 (node not found on PATH)" >&2; exit 1; }
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" derive-port "$@"

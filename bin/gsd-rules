#!/usr/bin/env bash
#
# gsd-rules — print the GSD toolkit's rules for the INSTALLED release.
#
# A set-up repo's .gsd/INSTRUCTIONS.md holds only its values and a short
# core; the rules themselves come from here, so a release changes them in
# every repo through gsd-update, with no step in each repo.
#
#   Claude Code: a user-level SessionStart hook (lib/install.sh) runs
#                `gsd-rules --hook`, which loads the output into the session.
#   Codex, custom: the AGENTS.md entry says to run `gsd-rules` first.
#
# Usage:
#   gsd-rules [--repo DIR]   the rules; in a repo with .gsd.conf also its
#                            values, and the screens paragraph only when
#                            ui_gates is not off. Outside one: all the rules.
#   gsd-rules --hook         for the Claude hook: reads (and ignores) the
#                            hook's stdin, prints the rules with a header in
#                            a repo with .gsd.conf, nothing elsewhere; always
#                            exits 0.
#   -h, --help               show this help
set -uo pipefail

usage() { awk 'NR>1 && /^set -uo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }

SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
GSD_PKG="$(cd "$(dirname "$SELF")/.." && pwd)"

REPO=""; HOOK=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || { echo "gsd-rules: --repo needs a directory" >&2; exit 2; }; REPO=$2; shift 2 ;;
    --hook) HOOK=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "gsd-rules: unknown argument: $1 (see --help)" >&2; exit 2 ;;
  esac
done

if [ "$HOOK" = 1 ]; then
  # Never let the hook break a session: no stdin wait, no error output.
  [ -t 0 ] || cat >/dev/null 2>&1 || true
  exec 2>/dev/null
  REPO=${REPO:-${CLAUDE_PROJECT_DIR:-$PWD}}
fi

# shellcheck source=../lib/common.sh
. "$GSD_PKG/lib/common.sh" || exit 0
# shellcheck source=../lib/provider.sh
. "$GSD_PKG/lib/provider.sh" || exit 0
# shellcheck source=../lib/version.sh
. "$GSD_PKG/lib/version.sh" || exit 0
# shellcheck source=../lib/ui.sh
. "$GSD_PKG/lib/ui.sh" || exit 0

MAIN=$(gsd_main "${REPO:-.}")
[ -n "$MAIN" ] && [ -f "$MAIN/.gsd.conf" ] || MAIN=""
if [ -z "$MAIN" ]; then
  [ "$HOOK" = 1 ] && exit 0
  [ -z "$REPO" ] || [ -d "$REPO" ] || { echo "gsd-rules: no such directory: $REPO" >&2; exit 2; }
  gsd_rules_text on
  exit 0
fi

ui=$(gsd_ui_gates "$MAIN"); ui_on=on; [ "$ui" != off ] || ui_on=off
providers=$(gsd_conf_providers "$MAIN")
out=$(gsd_rules_text "$ui_on"; gsd_repo_values "$providers" "${providers%%,*}" "$(gsd_base "$MAIN")" "$(gsd_wtdir "$MAIN")" "$ui" "$(gsd_flow_mode "$MAIN")")
if [ "$HOOK" = 1 ]; then
  printf 'GSD toolkit rules (gsd-rules, gsd-toolkit %s) — follow them in this repo; .gsd/INSTRUCTIONS.md has its settings.\n\n' "$(gsd_version)"
fi
printf '%s\n' "$out"
exit 0

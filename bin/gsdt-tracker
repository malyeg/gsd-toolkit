#!/usr/bin/env bash
#
# gsdt-tracker — read and write tickets (issues/tasks) from the shell.
#
# Works in any folder: a plain git repo, a GSD repo, or none. Standalone: it
# needs only src/launch.mjs, src/commands/tracker.ts and src/tracker/; the GSD
# toolkit runs it as a command (gsdt-start / gsdt-finish / the /gsdt-flow ticket
# step). `gsdt-tracker --help` lists the commands and settings.
#
# Launcher: the command is src/commands/tracker.ts (TypeScript, run by Node >= 24
# through src/launch.mjs); the help text is HELP in src/tracker/cli.ts. See
# docs/ts-port-progress.md. Exit codes: 0 ok · 1 usage/config error · 2 tracker
# call failed.
SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-tracker: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" tracker "$@"

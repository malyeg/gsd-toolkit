#!/usr/bin/env bash
#
# gsd-flow-next — which phase-flow step comes next, read from the phase folder.
#
# The step engine behind the /gsdt-flow skill. Looks at .planning/phases/<P>-*/
# in the checkout you are standing in (a phase worktree) and prints the FIRST
# step whose artifact is missing, in the agreed order. It runs nothing: the
# skill (or you) runs the printed command, then calls this again. Because it
# reads artifacts, it is resumable — after a crash or a /clear it simply says
# where you are. The same artifact list drives the guard's `flow = strict`
# rule and a repo's pre-merge gate, so what this considers done, they accept.
#
# Order:
#   ticket       <P>-TICKET.md (legacy: STORY.md, cu_<id>)   gsd-tracker snapshot
#                only when .gsd.conf sets tracker = clickup|custom
#   discuss      <P>-CONTEXT.md                             /gsd-discuss-phase
#   ui-decision  no UI-SPEC and no PLAN yet → the skill asks "screens?"
#   design-system .planning/design/DESIGN.md filled (screens,   gsd-ui design
#                before the UI-SPEC; one per project)
#   layout       <P>-LAYOUT.md: chosen /gsd-sketch + pages    gsd-ui layout, /gsd-sketch
#                (screens, before the UI-SPEC)
#   ui-phase     <P>-UI-SPEC.md (screens only)              /gsd-ui-phase
#   plan         a <P>-NN-PLAN.md                           /gsd-plan-phase
#   review       <P>-REVIEWS.md                             configured independent reviewer
#                                                           + /gsd-plan-phase --reviews
#   replan       a PLAN committed after REVIEWS.md            /gsd-plan-phase --reviews
#   execute      a SUMMARY for every PLAN                   /gsd-execute-phase
#   verifier     <P>-VERIFICATION.md exists                  (execute-phase re-run)
#   gaps         <P>-VERIFICATION.md status gaps_found      --gaps / --gaps-only
#   verify-work  a <P>-*UAT.md not pending/partial          /gsd-verify-work
#   code-review  <P>-REVIEW.md; not clean → <P>-REVIEW-FIX  /gsd-code-review [--fix]
#   ui-check     <P>-UI-CHECK.md passed, code unchanged     gsd-ui check
#                since (screens only)
#   ui-look      <P>-UI-LOOK.md: every picture and rule     gsd-ui look
#                answered, for that capture
#   ui-approve   <P>-UI-APPROVAL.md names that capture      gsd-ui sheet, gsd-ui approve
#   ui-review    <P>-UI-REVIEW.md (screens only)            /gsd-ui-review
#   validate     <P>-VALIDATION.md nyquist_compliant: true,  /gsd-validate-phase
#                or a "## Validation Audit" (manual-only left)
#                — not with workflow.nyquist_validation false
#   secure       <P>-SECURITY.md, threats_open: 0           /gsd-secure-phase
#   done         → gsd-finish
#
# Usage:
#   gsd-flow-next [<N>] [--repo <dir>] [--no-ui] [--all] [--json]
#     <N>       phase number; default: from the current phase-<N>-* branch
#     --no-ui   this phase has no screens (skips ui-decision/ui-phase/ui-review)
#     --ui      this phase has screens (settles ui-decision without a UI-SPEC)
#     --all     print every remaining step, not just the next one
#     --json    one JSON object per step
#
# design-system, layout, ui-check, ui-look and ui-approve are the UI gates
# (lib/ui.sh); `ui_gates = off` in .gsd.conf drops them. Phases whose UI-SPEC
# predates them skip the two pre-spec steps; a phase whose UI-REVIEW.md is
# already on the base branch skips the three checks of the rendered pages.
#
# review_provider = claude|codex|custom selects the independent reviewer.
# The external gsd-review skill performs delegation, not this shell command.
# Missing capabilities require a separate review session, never a skipped gate.
# A REVIEWS.md whose reviewer failed (Codex usage limit) does not count; with
# Codex the note points at gsd-codex-wait --wait-only.
#
# Output (text): key=value lines — step, run, then (optional second command),
# stop (why the skill must pause for the user after this step), note.
set -uo pipefail

SELF=$0
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
GSD_PKG=$(cd "$(dirname "$SELF")/.." && pwd)
. "$GSD_PKG/lib/common.sh"
. "$GSD_PKG/lib/provider.sh"
# shellcheck source=../lib/ticket.sh
. "$GSD_PKG/lib/ticket.sh"
# shellcheck source=../lib/ui.sh
. "$GSD_PKG/lib/ui.sh"

usage() { awk 'NR>1 && /^set -uo/{exit} NR>1 {sub(/^# ?/,""); print}' "$0"; }
N=""; REPO=""; UI=""; ALL=0; JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="$2"; shift ;;
    --no-ui) UI=no ;; --ui) UI=yes ;;
    --all) ALL=1 ;; --json) JSON=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 64 ;;
    *) N="$1" ;;
  esac
  shift
done
REPO="${REPO:-$PWD}"
REVIEW_PROVIDER=$(gsd_conf_get "$REPO" review_provider); REVIEW_PROVIDER=${REVIEW_PROVIDER:-codex}
! gsd_provider_gone "$REVIEW_PROVIDER" || { echo "review_provider = gemini: $GSD_GEMINI_GONE; set review_provider to claude, codex, or custom in .gsd.conf" >&2; exit 64; }
gsd_provider_known "$REVIEW_PROVIDER" || { echo "invalid review_provider '$REVIEW_PROVIDER'; use claude, codex, or custom" >&2; exit 64; }
if [ -z "$N" ]; then
  br=$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  case "$br" in phase-*) N=$(printf '%s' "$br" | sed -E 's/^phase-([0-9]+(\.[0-9]+)?).*/\1/') ;; esac
  [ -n "$N" ] || { echo "no phase number given and '$br' is not a phase-<N>-* branch" >&2; exit 64; }
fi
printf '%s' "$N" | grep -qE '^[0-9]+(\.[0-9]+)?$' || { echo "invalid phase number: $N" >&2; exit 64; }
case "$N" in *.*) P="$N" ;; *) P=$(printf '%02d' "$((10#$N))") ;; esac
"$GSD_PKG/bin/gsd-worktree-guard" --command gsdt-flow --phase "$N" --repo "$REPO" || exit $?
pd=""; for d in "$REPO/.planning/phases/$P"-*; do [ -d "$d" ] && { pd="$d"; break; }; done
[ -n "$pd" ] || { echo "no .planning/phases/$P-* directory in $REPO" >&2; exit 1; }

has() { [ -f "$pd/$P-$1" ]; }
fm()  { sed -n '/^---$/,/^---$/p' "$pd/$P-$1" 2>/dev/null | sed -n -E "s/^$2:[[:space:]]*//p" | head -1 | tr -d '[:space:]'; }
jstr() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

EMITTED=0
emit() {  # $1=step $2=run $3=then $4=stop $5=note
  # --all is a preview, not authorization to execute future steps. Location
  # was checked above; the current executable step is checked on normal calls.
  if [ "$ALL" = 0 ] && printf '%s' "$2" | grep -qE '^/gsd-'; then
    guard_cmd=${2%% *}; guard_cmd=${guard_cmd#/}; guard_args=${2#* }
    "$GSD_PKG/bin/gsd-worktree-guard" --command "$guard_cmd" --args "$guard_args" --repo "$REPO" || exit $?
  fi
  EMITTED=$((EMITTED + 1))
  if [ "$JSON" = 1 ]; then
    printf '{"phase":"%s","step":"%s","run":"%s","then":"%s","stop":"%s","note":"%s"}\n' \
      "$N" "$1" "$(jstr "$2")" "$(jstr "$3")" "$(jstr "$4")" "$(jstr "$5")"
  else
    [ "$EMITTED" -gt 1 ] && echo "--"
    printf 'step=%s\n' "$1"
    [ -n "$2" ] && printf 'run=%s\n' "$2"
    [ -n "$3" ] && printf 'then=%s\n' "$3"
    [ -n "$4" ] && printf 'stop=%s\n' "$4"
    [ -n "$5" ] && printf 'note=%s\n' "$5"
  fi
  [ "$ALL" = 1 ] || exit 0
}

# screens? A UI-SPEC or LAYOUT on disk settles it; otherwise --ui/--no-ui.
if has UI-SPEC.md || has LAYOUT.md; then UI=yes; fi
GATES=$(gsd_ui_gates "$REPO")

# 1 ticket — the tracker's issue/task, saved in the phase folder. The tag
# tk-<id> in the ROADMAP title (or dir name) says which one.
TRACKER=$(gsd_tracker_which "$REPO")
if [ "$TRACKER" != none ] && ! has TICKET.md && ! has STORY.md; then
  case "$pd" in *cu_*) ;; *)
    rel="${pd#"$REPO"/}/$P-TICKET.md"
    N_RE=$(printf '%s|%s' "$N" "$P" | sed 's/\./\\./g')
    # (pattern in a variable: bash 3.2 brace-expands {2,4} inside nested "$( … )")
    head_re="^#{2,4} Phase ($N_RE):"
    heading=$(grep -E "$head_re" "$REPO/.planning/ROADMAP.md" 2>/dev/null | head -1)
    tk=$(gsd_ticket_extract "$heading")
    [ -n "$tk" ] || tk=$(gsd_ticket_extract "$(basename "$pd")")
    if [ -n "$tk" ]; then
      emit ticket "gsd-tracker snapshot $tk --out $rel" "commit $rel" "" "saves $TRACKER ticket $tk (description + comments) for discuss and planning"
    else
      emit ticket "" "" "phase $N has no ticket: ask the user for its $TRACKER id, then run gsd-tracker snapshot <id> --out $rel and commit it (or write $rel by hand)" "a ticket holds the product intent, in product words"
    fi ;;
  esac
fi
# 2 discuss
discuss_then=""; [ "$TRACKER" = none ] || discuss_then="update the $TRACKER ticket to the agreed scope"
has CONTEXT.md || emit discuss "/gsd-discuss-phase $N" "$discuss_then" "discuss asks the user the open questions" "run it live — never auto-answer"
# 3 screens?
PLANS=""
for f in "$pd/$P"-[0-9]*-PLAN.md; do [ ! -f "$f" ] || PLANS=yes; done
if [ -z "$UI" ] && [ -z "$PLANS" ]; then
  emit ui-decision "" "" "does phase $N have screens? if the user already said (discuss, ticket, this session), use that; otherwise ask once. Then re-run with --ui or --no-ui" "UI is agreed BEFORE planning; plan-phase would otherwise auto-generate an un-agreed UI-SPEC"
fi
# 3b design system + layout — decided before the UI-SPEC, so the spec (and
# ui-review, which checks code against it) has a layout to hold the screens to.
if [ "$UI" = yes ] && [ "$GATES" != off ] && ! has UI-SPEC.md; then
  case "$(gsd_ui_design_state "$REPO")" in
    ok) ;;
    *) emit design-system "gsd-ui design" "" "agree the design system with the user and fill .planning/design/DESIGN.md (references, tokens, components, page templates), then delete its stub line. Start from real systems: offer the user the 3 closest from styles.refero.design, and chosen fonts, not the default" "one design system for every phase with screens; it is filled once, usually by the first such phase. ui_gates = off in .gsd.conf turns the UI gates off" ;;
  esac
  lrel="${pd#"$REPO"/}/$P-LAYOUT.md"
  case "$(gsd_ui_layout_state "$REPO" "$pd" "$P")" in
    missing)   emit layout "gsd-ui layout $N" "/gsd-sketch <this phase's main screen>" "the user picks the winning sketch variant; then write its folder in sketch:, the pages (URL paths) in pages:, and each page's main button in main_button: of $lrel" "sketch: skip <reason> only when the user agrees (e.g. a small change on an existing page)" ;;
    nosketch)  emit layout "/gsd-sketch <this phase's main screen>" "" "the user picks the winning sketch variant; then write its folder in sketch: of $lrel" "sketch: skip <reason> only when the user agrees" ;;
    badsketch) emit layout "" "" "sketch: in $lrel does not name a sketch folder — fix it (e.g. .planning/sketches/003-catalog)" "" ;;
    nowinner)  emit layout "" "" "the sketch in $lrel has no winner yet — ask the user to pick a variant and mark winner: in its README.md" "" ;;
    nopages)   emit layout "" "" "list the pages this phase builds (URL paths) in pages: of $lrel — gsd-ui check opens them" "" ;;
  esac
fi
# 4 ui-phase
if [ "$UI" = yes ] && ! has UI-SPEC.md; then
  ui_note=""; [ "$GATES" = off ] || ui_note="follow .planning/design/DESIGN.md and ${pd#"$REPO"/}/$P-LAYOUT.md (the chosen sketch); add the layout: sections top to bottom, the one main focus, the main button"
  emit ui-phase "/gsd-ui-phase $N" "" "run it now, without asking first; when it is done, the user must agree the screens before planning" "$ui_note"
fi
# 5 plan — always settle the research question, or plan-phase stops to ask
# it (it asks whenever RESEARCH.md is missing and no flag was given). Never
# --auto: that also chains into execute and skips the review gate.
# workflow.research in .planning/config.json (GSD's own setting) picks the
# answer; unreadable or unset = research (the plan checker wants its test list).
if [ -z "$PLANS" ]; then
  if has RESEARCH.md; then plan_run="/gsd-plan-phase $N"
  elif [ "$(gsd_workflow_flag "$REPO" research)" = false ]; then plan_run="/gsd-plan-phase $N --skip-research"
  else plan_run="/gsd-plan-phase $N --research"; fi
  emit plan "$plan_run" "" "" ""
fi
# 6 cross-AI review — a REVIEWS.md whose reviewer failed (e.g. hit the Codex
# usage limit) is no review: same test as the guard (gsd_reviews_problem).
rev_bad=""; has REVIEWS.md && rev_bad=$(gsd_reviews_problem "$pd/$P-REVIEWS.md" "$REVIEW_PROVIDER")
if ! has REVIEWS.md || [ -n "$rev_bad" ]; then
  if review_flag=$(gsd_provider_review_flag "$REVIEW_PROVIDER"); then
    review_run="/gsd-review --phase $N $review_flag"
  else
    review_run="request an independent custom-provider review of $pd and save verified findings to $P-REVIEWS.md"
  fi
  review_note="independent reviewer: $REVIEW_PROVIDER; external gsd-review capability required for automatic delegation. If unavailable, hand off the plans to a separate reviewer session and record $P-REVIEWS.md; never skip the gate."
  # A rerun costs a full review, and a large file may be a real one this check
  # misread: have it looked at first.
  if [ -n "$rev_bad" ]; then
    rev_lines=$(wc -l < "$pd/$P-REVIEWS.md" | tr -d ' ')
    if [ "$rev_lines" -gt 40 ]; then
      review_note="$P-REVIEWS.md is not a usable review ($rev_bad), but it has $rev_lines lines: open it and check before you delete it, because a rerun costs a full review. If it holds a real review, show the user and do not rerun. If the reviewer really failed, delete it and run again. $review_note"
    else
      review_note="$P-REVIEWS.md is not a usable review ($rev_bad): delete it and run the review again. $review_note"
    fi
  fi
  [ "$REVIEW_PROVIDER" != codex ] || review_note="$review_note On a Codex usage limit: run gsd-codex-wait --wait-only as a background job (it waits for the reset Codex gave, without calling Codex), delete $P-REVIEWS.md if one was written, then run this step again."
  emit review "$review_run" "/gsd-plan-phase $N --reviews" "show the user the independent findings before the replan; verify each against the plans, never accept on trust" "$review_note"
fi
# 6b replan — the --reviews replan leaves no artifact of its own, so use git:
# a plan committed after REVIEWS.md means it happened (commit_docs is on in a
# GSD repo). Same commit counts as done; REVIEWS.md uncommitted = not yet.
if has REVIEWS.md && [ -z "$rev_bad" ] && [ -n "$PLANS" ]; then
  rt=$(git -C "$REPO" log -1 --format=%ct -- "$pd/$P-REVIEWS.md" 2>/dev/null || true)
  pt=0; for f in "$pd/$P"-[0-9]*-PLAN.md; do [ -f "$f" ] || continue; t=$(git -C "$REPO" log -1 --format=%ct -- "$f" 2>/dev/null || true); [ "${t:-0}" -gt "$pt" ] && pt="$t"; done
  if [ -z "$rt" ] || [ "$pt" -lt "$rt" ]; then
    emit replan "/gsd-plan-phase $N --reviews" "" "" "REVIEWS.md exists but no plan was committed after it — the review was not folded into the plans"
  fi
fi
# 7 execute
MISSING=0; for f in "$pd/$P"-[0-9]*-PLAN.md; do [ -f "$f" ] || continue; [ -f "${f%-PLAN.md}-SUMMARY.md" ] || MISSING=$((MISSING + 1)); done
[ "$MISSING" -eq 0 ] || emit execute "/gsd-execute-phase $N" "" "" "$MISSING plan(s) without a SUMMARY; execute-phase runs code review and the verifier itself"
# 7b verifier — all plans done but the verifier never wrote its report
if [ -n "$PLANS" ] && [ "$MISSING" -eq 0 ] && ! has VERIFICATION.md; then
  emit verifier "/gsd-execute-phase $N" "" "" "every plan has a SUMMARY but there is no VERIFICATION.md; with all plans complete, execute-phase only runs the verifier"
fi
# 8 gaps
if [ "$(fm VERIFICATION.md status)" = "gaps_found" ]; then
  emit gaps "/gsd-plan-phase $N --gaps" "/gsd-execute-phase $N --gaps-only" "" "VERIFICATION.md reports gaps"
fi
# 9 verify-work
UATS=""; OPEN=""
for u in "$pd/$P"-*UAT.md; do [ -f "$u" ] || continue; UATS=yes; st=$(sed -n '/^---$/,/^---$/p' "$u" | sed -n -E 's/^status:[[:space:]]*//p' | head -1 | tr -d '[:space:]'); case "$st" in pending|partial) OPEN="$OPEN $(basename "$u")($st)";; esac; done
if [ -z "$UATS" ]; then emit verify-work "/gsd-verify-work $N" "" "" "agent-driven UAT walk (Playwright/screenshots), recorded as agent-verified. Use headless Playwright (no window) — never the user's own browser (Claude in Chrome, the browser pane, open <url>)"
elif [ -n "$OPEN" ]; then emit verify-work "/gsd-verify-work $N" "" "" "open UAT items:$OPEN"; fi
# 10 code review
if ! has REVIEW.md; then emit code-review "/gsd-code-review $N" "" "" "execute-phase normally produces this; missing means it errored"
else
  st=$(fm REVIEW.md status)
  case "$st" in ""|clean|skipped) ;; *) has REVIEW-FIX.md || emit code-review "/gsd-code-review $N --fix" "" "" "REVIEW.md status: $st" ;; esac
fi
# 11 the rendered pages: check → look → approve, then ui-review. gsd_ui_gate
# (lib/ui.sh) names the first open one; the guard and gsd-finish ask it too.
if [ "$UI" = yes ] && [ "$GATES" != off ] && ! gsd_ui_exempt "$REPO" "$pd" "$P"; then
  gate=$(gsd_ui_gate "$REPO" "$pd" "$P"); gstep=${gate%%|*}; gwhy=${gate##*|}
  gstate=${gate#*|}; gstate=${gstate%%|*}
  crel="${pd#"$REPO"/}/$P-UI-CHECK.md"
  if [ "$gstep" = ui-check ]; then
    case "$gstate" in
      failed) emit ui-check "gsd-ui check $N" "" "" "$gwhy: fix the pages, then check again. A finding the user accepts becomes a waive: line in $P-LAYOUT.md — never waive without asking" ;;
      stale)  emit ui-check "gsd-ui check $N" "" "" "$gwhy; start the app in this worktree first. Pages that look the same keep their look and approval" ;;
      *)      emit ui-check "gsd-ui check $N" "" "" "$gwhy; start the app in this worktree first. It opens each page at 3 widths, measures it and writes $crel and the pictures. If the pages cannot be checked, ask the user, then: gsd-ui check $N --skip \"<reason>\"" ;;
    esac
  fi
  case "$gstep" in ui-check|ui-look)
    [ "$gstep" = ui-look ] || gwhy="after the check"
    emit ui-look "gsd-ui look $N" "" "" "$gwhy: open every picture in $P-SHOTS/ and answer each line of $P-UI-LOOK.md (ok / fixed / bad / n/a — what you saw), then commit it. A bad line means: fix the page and check again" ;;
  esac
  case "$gstep" in ui-check|ui-look|ui-approve)
    [ "$gstep" = ui-approve ] || gwhy="after the look"
    emit ui-approve "gsd-ui sheet $N" "gsd-ui approve $N" "show the user the sheet and ask for a yes BEFORE gsd-ui approve; if the user does not want to look (or there are no pictures): gsd-ui approve $N --waive \"<reason>\"" "$gwhy" ;;
  esac
fi
if [ "$UI" = yes ] && ! has UI-REVIEW.md; then
  rv_note="phase has screens"
  [ "$GATES" = off ] || [ "$(gsd_ui_check_state "$REPO" "$pd" "$P" nostale)" != passed ] || rv_note="phase has screens: hold the pictures in $P-SHOTS/ and $P-UI-LOOK.md against the chosen sketch and the layout rules in $P-LAYOUT.md / DESIGN.md, not only the code"
  emit ui-review "/gsd-ui-review $N" "" "" "$rv_note"
fi
# 11b validate — every requirement gets a test (/gsd-validate-phase), after
# all code fixes so the tests see the final code; before secure, the last
# gate. Same test as the guard and doctor (gsd_validation_problem).
if val_bad=$(gsd_validation_problem "$pd" "$P" "$REPO"); then
  emit validate "/gsd-validate-phase $N" "" "" "$val_bad: find requirements without a test and write the missing tests (implementation files stay read-only). A gap the user leaves to a person is recorded as manual-only"
fi
# 12 secure — the last code gate
if ! has SECURITY.md; then emit secure "/gsd-secure-phase $N" "" "" "last code gate — after every --fix has landed"
else open=$(fm SECURITY.md threats_open); [ "${open:-0}" = 0 ] || emit secure "/gsd-secure-phase $N" "" "" "$open open threat(s)"; fi

emit "done" "gsd-finish" "" "gsd-finish deletes the worktree the session is standing in — it must be the LAST action" ""

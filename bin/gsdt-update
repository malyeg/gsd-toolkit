#!/usr/bin/env bash
#
# gsdt-update — update gsd-toolkit (a GitHub release, or the npm package) and
# GSD itself (gsd-core) to the latest version. `gsdt-update --help` says more.
set -euo pipefail

# Ported to TypeScript (src/commands/update.ts, which holds the --help text);
# this launcher only finds the package. A symlinked launcher tells the command
# which bin dir it sits in (the install's bin dir, kept by an update).
SELF=$0
if [ -L "$SELF" ]; then GSD_UPDATE_LINK_DIR=$(cd "$(dirname "$SELF")" && pwd -P); export GSD_UPDATE_LINK_DIR; fi
while [ -L "$SELF" ]; do t=$(readlink "$SELF"); case "$t" in /*) SELF=$t ;; *) SELF="$(dirname "$SELF")/$t" ;; esac; done
if ! command -v node >/dev/null 2>&1; then
  echo "gsdt-update: needs Node.js >= 24 (node not found on PATH)" >&2
  exit 1
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" update "$@"

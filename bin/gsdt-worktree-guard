#!/usr/bin/env bash
#
# gsdt-worktree-guard — shared validator called by gsdt-start and gsdt-flow-next.
# Optional native hooks use the same validator through a per-repo shim.
#
# Usage: gsdt-worktree-guard [--global] [--command gsd-… --args "…" --repo <dir>]
#   Without --command it reads Claude's hook JSON on stdin (UserPromptExpansion
#   .command_name/.command_args, or PreToolUse(Skill) .tool_input.skill/.args).
#
# Rules (independent of how the command was invoked):
#   0.  /gsd-new-project, /gsd-ingest-docs → only in a repo gsdt-init has set up
#       (.gsd.conf); gsdt-init installs the toolkit's files first.
#   0b. Skills that clash with the worktree model → never in a set-up repo:
#       /gsd-autonomous, /gsd-manager, /gsd-workspace, /gsd-workstreams,
#       /gsd-phase (add), --insert, --remove (--edit is allowed). The block
#       names the toolkit command (gsdt-start …).
#   1.  /gsd-phase --edit    → only on the base branch (the shared claim point).
#   2.  per-phase commands   → only inside the matching 'phase-<N>-*' worktree
#       (padded numbers compare numerically: 08 = 8, 02.1 = 2.1).
#   3.  /gsd-execute-phase   → also requires deps installed (background install
#       done) — skipped for repos with no install step.
#   4.  phase-flow order     → OPT-IN via `flow = strict` in .gsd.conf: plan-phase
#       needs <P>-CONTEXT.md (unless --prd); execute-phase needs a usable
#       <P>-REVIEWS.md (unless --gaps-only); secure-phase needs <P>-REVIEW.md,
#       <P>-UI-REVIEW.md when a UI-SPEC exists, and the test audit.
#   5.  UI gates             → OPT-IN via `ui_gates = strict` (lib/ui.sh):
#       ui-phase needs DESIGN.md and <P>-LAYOUT.md; ui-review needs the UI
#       check, look and approval of the built pages.
#
# --global: the user-level hook install.sh registers (~/.claude). It fires in
# EVERY repo: where there is no .gsd.conf it applies rule 0 only. In a set-up
# repo it applies every rule (it is the only hook that sees a slash command the
# user TYPES). An unreadable payload is let through in this mode.
#
# Block = exit 2 (stderr shown), usage error = 64. Escape hatch: GSD_SKIP_GUARD=1.
# Repo settings (base branch, install cmd, flow): .gsd.conf, see gsdt-bootstrap-repo.
#
# Launcher: the command is src/commands/worktree-guard.ts (TypeScript, run by
# Node >= 24 through src/launch.mjs; the rules are in src/guard.ts). It fails
# closed: without a usable node, or on any crash, a block (exit 2) — except with
# --global, which fails open like an unreadable payload.
[ "${GSD_SKIP_GUARD:-}" = 1 ] && exit 0
SELF="$0"
while [ -L "$SELF" ]; do
  tgt=$(readlink "$SELF")
  case "$tgt" in /*) SELF="$tgt" ;; *) SELF="$(dirname "$SELF")/$tgt" ;; esac
done
if ! command -v node >/dev/null 2>&1; then
  for a in "$@"; do [ "$a" = --global ] && exit 0; done
  echo 'BLOCKED: gsdt-worktree-guard needs Node.js >= 24 (node not found on PATH)' >&2
  exit 2
fi
exec node "$(cd "$(dirname "$SELF")/.." && pwd)/src/launch.mjs" worktree-guard "$@"
